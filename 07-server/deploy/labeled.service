[Unit]
Description=labeled API (Mini App)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=labeled
Group=labeled
WorkingDirectory=/opt/labeled/server
EnvironmentFile=/etc/labeled/server.env
ExecStart=/opt/node/bin/node dist/main.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/labeled

[Install]
WantedBy=multi-user.target
